# BreatheWell environment variables (names fixed by setup-steps.html). Never commit values.
# With none of these set, the app still builds and serves the public pages and the demo.

# Firebase web config (public, inlined at build time)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only)
FIREBASE_PROJECT_ID=
# Local development: path to a service-account file kept OUTSIDE the repo
GOOGLE_APPLICATION_CREDENTIALS=
# Vercel: the same service-account JSON, base64-encoded
FIREBASE_SERVICE_ACCOUNT_B64=

# Gemini (free AI Studio key, server only)
GEMINI_API_KEY=
# A pinned, versioned model ID (not the hot-swapped gemini-flash-latest alias)
GEMINI_MODEL=gemini-3.8-flash

# Public origin of the deployed app, e.g. https://breathewell.vercel.app. Set it on every deploy:
# invite links, the join QR code, WhatsApp texts and the CSRF origin check use it. Without it the
# request's host is used only when it is a local host or one of Vercel's own VERCEL_*_URL hosts.
APP_ORIGIN=

# Only when self-hosting behind a proxy you control that appends the client IP to X-Forwarded-For
# and sets X-Forwarded-Host: set to 1. Never set it on Vercel or on a bare `next start`.
TRUST_PROXY=

# Vercel only: any long random string. Vercel Cron sends it to /api/cron/cleanup, the daily job
# that deletes expired data (Firestore TTL needs billing, so Spark relies on this job).
CRON_SECRET=

# Optional: data.gov.in key for CPCB station readings (spec S1)
DATA_GOV_IN_KEY=
